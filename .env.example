# Paste your real key into Railway's service variables, never into this repo.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# Swap point for a different provider (xAI: https://api.x.ai/v1)
GROQ_BASE_URL=https://api.groq.com/openai/v1
MODEL=openai/gpt-oss-120b

SYSTEM_PROMPT=You are a fast, concise, helpful assistant. Prefer short, direct answers.

# Optional shared-password gate. Leave unset for an open bot.
ACCESS_PASSWORD=

PORT=3099

# --- WhatsApp Business Cloud API (optional) -------------------------------
# Leave unset and the webhook stays inert: it refuses every call and the web
# app is untouched. Set all five to bring the WhatsApp bot up.
WHATSAPP_TOKEN=                 # permanent system-user access token
WHATSAPP_PHONE_NUMBER_ID=       # the sending number's ID, not the number
WHATSAPP_APP_SECRET=            # app secret, used to verify webhook signatures
WHATSAPP_VERIFY_TOKEN=          # any string you choose; paste the same one into Meta
WHATSAPP_API_VERSION=v21.0      # bump to whatever your WABA uses
PUBLIC_BASE_URL=                # e.g. https://grok-bot-production-b3a4.up.railway.app
                                # needed so the welcome image and voice note can be sent by link
